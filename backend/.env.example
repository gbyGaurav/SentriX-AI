# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/uamd
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/uamd

# LLM Configuration
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini

# Security
ALLOWED_ORIGINS=http://localhost:3000
SECRET_KEY=your-secret-key-change-in-production

# File Limits (bytes)
MAX_FILE_SIZE_IMAGE=10485760
MAX_FILE_SIZE_VIDEO=104857600
MAX_FILE_SIZE_PDF=26214400
MAX_FILE_SIZE_AUDIO=52428800
MAX_FILE_SIZE_DOCUMENT=26214400

# Model Paths
MODEL_PATH=./models

# Features
ENABLE_AUDIO_PROCESSING=false
ENABLE_VIDEO_PROCESSING=true
ENABLE_LLM=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30
